require "test"

# A provider for the tests: keys numbered by the calls, expiring `ttl`
# from now (or none), failing while `failing` holds.
data Counting(calls: Atom[Int], ttl: Duration?, failing: Atom[Bool])
  include AWS::Credentials::Provider

  def self.make(ttl: Duration? = nil) -> Counting = Counting.new(Atom.new(0), ttl, Atom.new(false))

  def get -> AWS::Credentials::Keys
    n = calls.update { |c| c + 1 }
    raise AWS::CredentialsError.new("counting says no") if failing.get
    t = ttl
    AWS::Credentials::Keys.new("AKID#{n}", "secret#{n}", nil, t ? Time.now + t : nil)
  end

  def name -> String = "counting"
end

# Fake endpoints and temporary files.
module Fakes
  # Serves `handler` on a port of its own while the block runs, giving
  # its base URL.
  def self.serving(handler: HTTP::Handler, &: (String) -> Void) -> Void
    server = HTTP::Server.new(handler, host: "127.0.0.1", port: 0)
    Task.scope do |scope|
      scope.spawn { server.serve }
      begin
        yield "http://127.0.0.1:#{server.local_address.port}"
      ensure
        server.shutdown
      end
    end
    nil
  end

  # A client that never goes through a proxy (the environment may name
  # one).
  def self.client -> HTTP::Client = HTTP::Client.new(proxy: nil, timeout: 5.seconds)

  # A directory of its own while the block runs.
  def self.dir(&: (String) -> Void) -> Void
    d = "#{Dir.tmpdir}/aws-test-#{Crypto.random_bytes(6).hex}"
    Dir.mkdir_p(d)
    begin
      yield d
    ensure
      Dir.rm_rf(d)
    end
    nil
  end

  # STS's answer with keys, as `result` (`AssumeRoleResult`), with a
  # namespace and indentation.
  def self.sts_answer(result: String, id: String, expires: Time) -> String
    action = result.sub("Result", "")
    <<~XML
      <?xml version="1.0" encoding="UTF-8"?>
      <#{action}Response xmlns="https://sts.amazonaws.com/doc/2011-06-15/">
        <#{result}>
          <AssumedRoleUser><Arn>arn:aws:sts::123456789012:assumed-role/r/s</Arn></AssumedRoleUser>
          <Credentials>
            <AccessKeyId>#{id}</AccessKeyId>
            <SecretAccessKey>s3cr&amp;t</SecretAccessKey>
            <SessionToken>
              tok&#x2B;en
            </SessionToken>
            <Expiration>#{expires.utc.iso8601}</Expiration>
          </Credentials>
        </#{result}>
        <ResponseMetadata><RequestId>r-1</RequestId></ResponseMetadata>
      </#{action}Response>
    XML
  end

  # Whether `req` (its body `body`) carries a SigV4 signature made with
  # `secret`, recomputed over what was received.
  def self.signed?(req: HTTP::Server::Request, body: String, secret: String) -> Bool
    auth = req.headers["authorization"] || return false
    m = auth.match(/\AAWS4-HMAC-SHA256 Credential=([^\/]+)\/(\d{8})\/([^\/]+)\/([^\/]+)\/aws4_request, SignedHeaders=([^,]+), Signature=([0-9a-f]{64})\z/)
    return false if m.nil?
    names = m[5].as(String).split(";")
    headers = HTTP::Headers.empty
    names.each { |n| req.headers.all(n).each { |v| headers = headers.add(n, v) } }
    d = req.headers["x-amz-date"] || return false
    t = Time.utc(d[0, 4].to_i, d[4, 2].to_i, d[6, 2].to_i, d[9, 2].to_i, d[11, 2].to_i, d[13, 2].to_i)
    url = URI.parse("http://#{req.headers["host"]}#{req.target}")
    keys = AWS::Credentials::Keys.new(m[1].as(String), secret)
    parts = AWS::SigV4.parts(req.method, url, headers, Digest::SHA256.hexdigest(body), service: m[4].as(String),
                             region: m[3].as(String), credentials: keys, time: t)
    parts.signature == m[6] && parts.signed_headers == m[5]
  end
end

class KeysTest < Test::Case
  def test_inspect_hides_the_secret_and_the_token
    k = AWS::Credentials::Keys.new("AKIDEXAMPLE", "wJalrXUtnFEMI", "SESSIONTOKEN", Time.utc(2026, 11, 7, 12))
    assert_equal("#<AWS::Credentials::Keys AKIDEXAMPLE expires 2026-11-07T12:00:00Z>", k.inspect)
    assert_equal(k.inspect, k.to_s)
    [[k].inspect, {"k" => k}.inspect, "#{k}", [k].to_s].each do |s|
      assert(!s.include?("wJalrXUtnFEMI") && !s.include?("SESSIONTOKEN"), s)
      assert(s.include?("AKIDEXAMPLE"), s)
    end
    assert_equal("#<AWS::Credentials::Keys AKID>", AWS::Credentials::Keys.new("AKID", "s").inspect)
  end

  def test_stale_and_expired
    now = Time.now
    k = AWS::Credentials::Keys.new("a", "s", "t", now + 4.minutes)
    assert(k.stale?(now))
    assert(!k.expired?(now))
    assert(k.expired?(now + 5.minutes))
    assert(!AWS::Credentials::Keys.new("a", "s").stale?(now))
  end
end

class SimpleProvidersTest < Test::Case
  def test_static
    p = AWS::Credentials.static(access_key_id: "AKID", secret_access_key: "s", session_token: "t")
    assert_equal(AWS::Credentials::Keys.new("AKID", "s", "t"), p.get)
  end

  def test_env
    env = {"AWS_ACCESS_KEY_ID" => "AKID", "AWS_SECRET_ACCESS_KEY" => "s", "AWS_SESSION_TOKEN" => "t"}
    assert_equal(AWS::Credentials::Keys.new("AKID", "s", "t"), AWS::Credentials.env(env).get)
    assert_equal(AWS::Credentials::Keys.new("AKID", "s"), AWS::Credentials.env(env.merge({"AWS_SESSION_TOKEN" => ""})).get)
    e = assert_raise(AWS::CredentialsError) { AWS::Credentials.env({"AWS_ACCESS_KEY_ID" => "AKID"}).get }
    assert_match(/not both set/, e.message)
  end
end

class CacheAndChainTest < Test::Case
  def test_kept_until_stale
    c = Counting.make(1.hour)
    cached = AWS::Credentials::Cached.new(c)
    assert_equal("AKID1", cached.get.access_key_id)
    assert_equal("AKID1", cached.get.access_key_id)
    assert_equal(1, c.calls.get)
    # Without an expiry: kept for good.
    forever = Counting.make
    f = AWS::Credentials::Cached.new(forever)
    f.get
    f.get
    assert_equal(1, forever.calls.get)
  end

  def test_refreshed_within_the_margin
    c = Counting.make(4.minutes)
    cached = AWS::Credentials::Cached.new(c)
    assert_equal("AKID1", cached.get.access_key_id)
    assert_equal("AKID2", cached.get.access_key_id)
  end

  def test_a_failed_refresh_keeps_the_old_keys_until_they_expire
    c = Counting.make(4.minutes)
    cached = AWS::Credentials::Cached.new(c)
    assert_equal("AKID1", cached.get.access_key_id)
    c.failing.set(true)
    assert_equal("AKID1", cached.get.access_key_id)
    # Expired: the failure is raised.
    gone = Counting.make(-1.second)
    g = AWS::Credentials::Cached.new(gone)
    g.get
    gone.failing.set(true)
    assert_raise(AWS::CredentialsError) { g.get }
  end

  def test_refresh_from_many_tasks
    c = Counting.make(1.hour)
    cached = AWS::Credentials::Cached.new(c)
    ids = Task.scope do |scope|
      tasks = (1..8).map { |_| scope.spawn { cached.get.access_key_id } }
      tasks.map { |t| t.await }
    end
    assert(ids.all? { |i| i.start_with?("AKID") })
    assert(c.calls.get <= 8)
    assert_equal(ids.last, cached.get.access_key_id)
  end

  def test_chain_tries_in_order_and_remembers
    a = Counting.make
    a.failing.set(true)
    b = Counting.make
    chain = AWS::Credentials.chain([a, b])
    assert_equal("AKID1", chain.get.access_key_id)
    assert_equal(1, a.calls.get)
    # The one that answered is tried first.
    chain.get
    assert_equal(1, a.calls.get)
    assert_equal(2, b.calls.get)
  end

  def test_chain_says_what_it_tried
    a = Counting.make
    a.failing.set(true)
    chain = AWS::Credentials.chain([a, AWS::Credentials.env(Hash[String, String].new)])
    e = assert_raise(AWS::CredentialsError) { chain.get }
    assert_equal("no credentials: counting: counting says no; environment: AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are not both set", e.message)
    assert_raise(ArgumentError) { AWS::Credentials.chain(Array[AWS::Credentials::Provider].new) }
  end

  def test_default_without_anything
    Fakes.dir do |d|
      env = {"HOME" => d, "AWS_EC2_METADATA_DISABLED" => "true"}
      e = assert_raise(AWS::CredentialsError) { AWS::Credentials.default(env).get }
      ["environment", "web identity", "profile default", "container", "instance"].each { |n| assert(e.message.include?("#{n}: "), e.message) }
    end
  end
end

class ProfileTest < Test::Case
  def files(d: String, credentials: String, config: String) -> Hash[String, String]
    Dir.mkdir_p("#{d}/.aws")
    File.write("#{d}/.aws/credentials", credentials)
    File.write("#{d}/.aws/config", config)
    {"HOME" => d}
  end

  def test_both_files
    Fakes.dir do |d|
      env = files(d, "[default]\naws_access_key_id = AKIDDEF\naws_secret_access_key = sdef\n\n[dev]\naws_access_key_id=AKIDDEV\naws_secret_access_key=sdev\naws_session_token = tdev\n",
                  "[default]\nregion = eu-west-1\n[profile dev]\naws_access_key_id = FROMCONFIG\nregion = us-east-2\n[profile cfgonly]\naws_access_key_id = AKIDCFG\naws_secret_access_key = scfg\n[sso-session x]\nregion = no\n")
      assert_equal(AWS::Credentials::Keys.new("AKIDDEF", "sdef"), AWS::Credentials.profile(env: env).get)
      # The credentials file wins over the config file.
      assert_equal(AWS::Credentials::Keys.new("AKIDDEV", "sdev", "tdev"), AWS::Credentials.profile("dev", env: env).get)
      assert_equal("AKIDCFG", AWS::Credentials.profile("cfgonly", env: env).get.access_key_id)
      assert_equal("AKIDDEV", AWS::Credentials.profile(env: env.merge({"AWS_PROFILE" => "dev"})).get.access_key_id)
      assert_equal("eu-west-1", AWS::Profiles.region(nil, env))
      assert_equal("us-east-2", AWS::Profiles.region("dev", env))
      assert_nil(AWS::Profiles.settings("x", env))
      e = assert_raise(AWS::CredentialsError) { AWS::Credentials.profile("missing", env: env).get }
      assert_equal("no profile missing", e.message)
    end
  end

  def test_files_named_by_the_environment
    Fakes.dir do |d|
      File.write("#{d}/c", "[p]\naws_access_key_id = AKIDP\naws_secret_access_key = sp\n")
      File.write("#{d}/k", "[profile p]\nregion = ap-northeast-1\n")
      env = {"HOME" => "/nonexistent", "AWS_SHARED_CREDENTIALS_FILE" => "#{d}/c", "AWS_CONFIG_FILE" => "#{d}/k"}
      assert_equal("AKIDP", AWS::Credentials.profile("p", env: env).get.access_key_id)
      assert_equal("ap-northeast-1", AWS::Profiles.region("p", env))
    end
  end

  def test_a_role_from_a_source_profile
    calls = Atom.new(0)
    handler = HTTP.handler do |req|
      body = req.body.read
      calls.update { |c| c + 1 }
      form = URI.decode_www_form(body)
      ok = Fakes.signed?(req, body, "ssrc") && form["Action"]? == ["AssumeRole"] && form["RoleArn"]? == ["arn:aws:iam::123456789012:role/r"] &&
           form["ExternalId"]? == ["ext"] && form["DurationSeconds"]? == ["900"] && form["RoleSessionName"]? == ["sess"] &&
           (req.headers["authorization"] || "").include?("Credential=AKIDSRC/")
      if ok
        HTTP::Server::Response.text(Fakes.sts_answer("AssumeRoleResult", "ASIAROLE", Time.now + 1.hour))
      else
        HTTP::Server::Response.text("<ErrorResponse><Error><Code>SignatureDoesNotMatch</Code><Message>no</Message></Error></ErrorResponse>", 403)
      end
    end
    Fakes.serving(handler) do |base|
      Fakes.dir do |d|
        Dir.mkdir_p("#{d}/.aws")
        File.write("#{d}/.aws/credentials", "[src]\naws_access_key_id = AKIDSRC\naws_secret_access_key = ssrc\n")
        File.write("#{d}/.aws/config", "[profile r]\nrole_arn = arn:aws:iam::123456789012:role/r\nsource_profile = src\nexternal_id = ext\nduration_seconds = 900\nrole_session_name = sess\nregion = eu-west-1\n" +
                                       "[profile deep]\nrole_arn = arn:aws:iam::1:role/x\nsource_profile = r\n[profile nokeys]\nregion = x\n[profile bad]\nrole_arn = arn:aws:iam::1:role/x\nsource_profile = nokeys\n")
        env = {"HOME" => d, "AWS_ENDPOINT_URL_STS" => "#{base}/"}
        p = AWS::Credentials.profile("r", env: env, http: Fakes.client)
        k = p.get
        assert_equal("ASIAROLE", k.access_key_id)
        assert_equal("s3cr&t", k.secret_access_key)
        assert_equal("tok+en", k.session_token)
        assert(!k.expires_at.nil?)
        p.get
        assert_equal(1, calls.get)
        e = assert_raise(AWS::CredentialsError) { AWS::Credentials.profile("deep", env: env, http: Fakes.client).get }
        assert_match(/source_profile of deep, assumes a role itself \(one level only\)/, e.message)
        e = assert_raise(AWS::CredentialsError) { AWS::Credentials.profile("bad", env: env, http: Fakes.client).get }
        assert_match(/has no keys of its own/, e.message)
      end
    end
  end

  def test_parse
    text = "  # comment\n; another\n[default]\n Region = x \nnot a setting\n[profile a]\nk=v=w\n"
    assert_equal({"default" => {"region" => "x"}, "a" => {"k" => "v=w"}}, AWS::Profiles.parse(text, true))
    assert_equal({"default" => {"region" => "x"}, "profile a" => {"k" => "v=w"}}, AWS::Profiles.parse(text, false))
  end
end

class ContainerTest < Test::Case
  def answer(expires: Time) -> String
    JSON.generate({"AccessKeyId" => "ASIACONT", "SecretAccessKey" => "scont", "Token" => "tcont", "Expiration" => expires.utc.iso8601})
  end

  def test_full_uri_with_a_token
    exp = Time.now + 1.hour
    body = answer(exp)
    handler = HTTP.handler do |req|
      if req.path == "/creds" && req.headers["authorization"] == "Bearer xyz"
        HTTP::Server::Response.text(body)
      else
        HTTP::Server::Response.text("no", 401)
      end
    end
    Fakes.serving(handler) do |base|
      env = {"AWS_CONTAINER_CREDENTIALS_FULL_URI" => "#{base}/creds", "AWS_CONTAINER_AUTHORIZATION_TOKEN" => "Bearer xyz"}
      k = AWS::Credentials.container(env: env, http: Fakes.client).get
      assert_equal("ASIACONT", k.access_key_id)
      assert_equal("tcont", k.session_token)
      assert_equal(exp.to_i, k.expires_at.as(Time).to_i)
      # The token file, read each time, wins.
      Fakes.dir do |d|
        File.write("#{d}/token", "Bearer xyz\n")
        k = AWS::Credentials.container(env: env.merge({"AWS_CONTAINER_AUTHORIZATION_TOKEN" => "wrong", "AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE" => "#{d}/token"}), http: Fakes.client).get
        assert_equal("ASIACONT", k.access_key_id)
      end
      e = assert_raise(AWS::CredentialsError) { AWS::Credentials.container(env: env.merge({"AWS_CONTAINER_AUTHORIZATION_TOKEN" => "wrong"}), http: Fakes.client).get }
      assert_equal("the container endpoint answered 401", e.message)
    end
  end

  def test_relative_uri_against_the_base
    handler = HTTP.handler { |req| req.path == "/v2/credentials/abc" ? HTTP::Server::Response.text(JSON.generate({"AccessKeyId" => "ASIAREL", "SecretAccessKey" => "s"})) : HTTP::Server::Response.not_found }
    Fakes.serving(handler) do |base|
      p = AWS::Credentials.container(env: {"AWS_CONTAINER_CREDENTIALS_RELATIVE_URI" => "/v2/credentials/abc"}, base: base, http: Fakes.client)
      assert_equal("ASIAREL", p.get.access_key_id)
    end
  end

  def test_which_full_uris
    url = ->(u: String) { AWS::Credentials::Container.url({"AWS_CONTAINER_CREDENTIALS_FULL_URI" => u}, "http://169.254.170.2").to_s }
    ["http://127.0.0.1:8080/c", "http://127.1.2.3/c", "http://localhost/c", "http://[::1]/c", "http://169.254.170.2/c",
     "http://169.254.170.23/c", "http://[fd00:ec2::23]/c", "https://example.com/c"].each { |u| assert_equal(u, url.call(u)) }
    ["http://example.com/c", "http://10.0.0.1/c", "http://[fd00:ec2::24]/c", "ftp://127.0.0.1/c"].each do |u|
      assert_raise(AWS::CredentialsError) { url.call(u) }
    end
    e = assert_raise(AWS::CredentialsError) { AWS::Credentials::Container.url(Hash[String, String].new, "x") }
    assert_match(/not set/, e.message)
  end
end

class InstanceTest < Test::Case
  # IMDSv2: a new token at each PUT, the last one alone accepted.
  def imds(tokens: Atom[Int], ttl: Duration) -> HTTP::Handler
    HTTP.handler do |req|
      current = "token-#{tokens.get}"
      if req.method == "PUT" && req.path == "/latest/api/token"
        if req.headers["x-aws-ec2-metadata-token-ttl-seconds"] == "21600"
          n = tokens.update { |t| t + 1 }
          HTTP::Server::Response.text("token-#{n}")
        else
          HTTP::Server::Response.text("", 400)
        end
      elsif req.headers["x-aws-ec2-metadata-token"] != current
        HTTP::Server::Response.text("", 401)
      elsif req.path == "/latest/meta-data/iam/security-credentials/"
        HTTP::Server::Response.text("my-role\n")
      elsif req.path == "/latest/meta-data/iam/security-credentials/my-role"
        HTTP::Server::Response.text(JSON.generate({"Code" => "Success", "AccessKeyId" => "ASIAEC2#{tokens.get}", "SecretAccessKey" => "s",
                                                   "Token" => "t", "Expiration" => (Time.now + ttl).utc.iso8601}))
      else
        HTTP::Server::Response.not_found
      end
    end
  end

  def test_token_then_role_then_keys
    tokens = Atom.new(0)
    Fakes.serving(imds(tokens, 1.hour)) do |base|
      p = AWS::Credentials.instance(env: Hash[String, String].new, base: base, http: Fakes.client)
      assert_equal("ASIAEC21", p.get.access_key_id)
      p.get
      assert_equal(1, tokens.get)
      # The endpoint from the environment.
      q = AWS::Credentials.instance(env: {"AWS_EC2_METADATA_SERVICE_ENDPOINT" => base}, http: Fakes.client)
      assert_equal("ASIAEC22", q.get.access_key_id)
    end
  end

  def test_near_expiry_a_new_token_and_keys
    tokens = Atom.new(0)
    Fakes.serving(imds(tokens, 4.minutes)) do |base|
      p = AWS::Credentials.instance(env: Hash[String, String].new, base: base, http: Fakes.client)
      assert_equal("ASIAEC21", p.get.access_key_id)
      assert_equal("ASIAEC22", p.get.access_key_id)
    end
  end

  def test_disabled_and_unreachable
    e = assert_raise(AWS::CredentialsError) { AWS::Credentials.instance(env: {"AWS_EC2_METADATA_DISABLED" => "TRUE"}).get }
    assert_equal("AWS_EC2_METADATA_DISABLED is true", e.message)
    # Nothing listens on port 1: one attempt, quickly.
    started = Time.monotonic
    e = assert_raise(AWS::CredentialsError) { AWS::Credentials.instance(env: Hash[String, String].new, base: "http://127.0.0.1:1").get }
    assert_match(/could not be reached/, e.message)
    assert(Time.monotonic - started < 3.seconds)
  end
end

class WebIdentityTest < Test::Case
  def test_assume_role_with_web_identity
    seen = Atom[Array[String]].new([])
    handler = HTTP.handler do |req|
      form = req.form_params
      tok = (form["WebIdentityToken"]? || [""])[0]
      seen.update { |s| s + [tok] }
      ok = req.method == "POST" && !req.headers.key?("authorization") && form["Action"]? == ["AssumeRoleWithWebIdentity"] &&
           form["RoleArn"]? == ["arn:aws:iam::123456789012:role/web"] && form["RoleSessionName"]? == ["s1"] && form["Version"]? == ["2011-06-15"]
      if ok
        HTTP::Server::Response.text(Fakes.sts_answer("AssumeRoleWithWebIdentityResult", "ASIAWEB", Time.now + 4.minutes))
      else
        HTTP::Server::Response.text("<ErrorResponse xmlns=\"x\"><Error><Type>Sender</Type><Code>InvalidIdentityToken</Code><Message>bad &lt;token&gt;</Message></Error></ErrorResponse>", 400)
      end
    end
    Fakes.serving(handler) do |base|
      Fakes.dir do |d|
        File.write("#{d}/token", "jwt-1\n")
        env = {"AWS_WEB_IDENTITY_TOKEN_FILE" => "#{d}/token", "AWS_ROLE_ARN" => "arn:aws:iam::123456789012:role/web", "AWS_ROLE_SESSION_NAME" => "s1"}
        p = AWS::Credentials.web_identity(env: env, endpoint: "#{base}/", http: Fakes.client)
        k = p.get
        assert_equal("ASIAWEB", k.access_key_id)
        assert_equal("tok+en", k.session_token)
        # Stale (4 minutes left): refreshed, the token file read again.
        File.write("#{d}/token", "jwt-2")
        p.get
        assert_equal(["jwt-1", "jwt-2"], seen.get)
        e = assert_raise(AWS::CredentialsError) { AWS::Credentials.web_identity(env: env.merge({"AWS_ROLE_SESSION_NAME" => "x"}), endpoint: "#{base}/", http: Fakes.client).get }
        assert_equal("STS AssumeRoleWithWebIdentity answered 400: InvalidIdentityToken (bad <token>)", e.message)
      end
    end
    e = assert_raise(AWS::CredentialsError) { AWS::Credentials.web_identity(env: Hash[String, String].new).get }
    assert_match(/not both set/, e.message)
  end

  def test_sts_endpoints
    none = Hash[String, String].new
    assert_equal("https://sts.eu-west-1.amazonaws.com/", AWS::STS.endpoint("eu-west-1", none))
    assert_equal("https://sts.amazonaws.com/", AWS::STS.endpoint(nil, none))
    assert_equal("http://localhost:4566", AWS::STS.endpoint("eu-west-1", {"AWS_ENDPOINT_URL" => "http://localhost:4566"}))
    assert_equal("http://sts", AWS::STS.endpoint(nil, {"AWS_ENDPOINT_URL" => "http://x", "AWS_ENDPOINT_URL_STS" => "http://sts"}))
  end
end

class STSXMLTest < Test::Case
  def test_fields
    xml = "<?xml version=\"1.0\"?>\n<a:R xmlns:a=\"u\"><a:K attr=\"1\"> v &amp; &#65;&#x42; </a:K><E/><!-- c > d --><K>second</K></a:R>"
    assert_equal({"K" => "v & AB", "E" => ""}, AWS::STSXML.fields(xml, ["K", "E", "Missing"]))
  end

  def test_refusals
    ["<!DOCTYPE x [<!ENTITY e SYSTEM \"file:///etc/passwd\">]><R>&e;</R>", "<R><![CDATA[x]]></R>", "<R><K>x</R>",
     "<R><K>x</K>", "<R>&bogus;</R>", "<R>a < b</R>", "<R><?pi x?></R>", "<R>&#0;</R>"].each do |x|
      assert_raise(AWS::CredentialsError) { AWS::STSXML.fields(x, ["K"]) }
    end
  end
end
