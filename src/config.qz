require "http"
require "uri"

# What a service client needs: the region, the credentials, where to
# send requests, the HTTP client, and the retry rules.
#
# ```
# creds = AWS::Credentials.static(access_key_id: "AKIDEXAMPLE", secret_access_key: "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY")
# config = AWS::Config.new(region: "ap-northeast-1", credentials: creds)
# config.endpoint_for("kms").to_s   # => "https://kms.ap-northeast-1.amazonaws.com"
# ```
data Config(
  # The region: `ap-northeast-1`.
  region: String,
  # Where the keys come from.
  credentials: Credentials::Provider,
  # Where to send every service's requests (a local emulator), nil for
  # AWS's endpoints.
  endpoint: URI? = nil,
  # The client the requests go through (`Config.client` by default: one
  # that follows no redirect, which would take a request's body
  # elsewhere).
  http: HTTP::Client = Config.client,
  # How many times a request is tried again after a failure that may
  # pass: throttling, a 5xx, a transport error.
  retries: Int = 3,
  # The longest one attempt may take.
  timeout: Duration = 30.seconds,
  # The backoff before the n-th retry is a random time up to
  # `min(retry_cap, retry_base * 2**n)` (full jitter).
  retry_base: Duration = 100.milliseconds,
  # The longest backoff.
  retry_cap: Duration = 20.seconds,
  # Endpoints for one service each (`kms` => URI), before `endpoint`:
  # what AWS_ENDPOINT_URL_KMS gives.
  service_endpoints: Hash[String, URI] = Hash[String, URI].new
)
  # The configuration of the environment: the region of AWS_REGION,
  # AWS_DEFAULT_REGION or the profile's `region`, the credentials of
  # `Credentials.default`, the endpoints of AWS_ENDPOINT_URL and
  # AWS_ENDPOINT_URL_<SERVICE> (KMS: AWS_ENDPOINT_URL_KMS).
  #
  # ## Raises
  #
  # `AWS::Error` when no region is set, `ArgumentError` for an endpoint
  # that is not a URL.
  def self.default(env: Hash[String, String] = ENV) -> Config
    region = Config.nonempty(env["AWS_REGION"]?) || Config.nonempty(env["AWS_DEFAULT_REGION"]?) || Profiles.region(nil, env)
    raise Error.new("no region: set AWS_REGION, or a region in the profile") if region.nil? || region.empty?
    general = Config.nonempty(env["AWS_ENDPOINT_URL"]?)
    services = Hash::Builder[String, URI].new
    env.each do |k, v|
      if k.start_with?("AWS_ENDPOINT_URL_") && !v.empty?
        services[k[17, k.size - 17].downcase] = URI.parse(v)
      end
    end
    Config.new(region, Credentials.default(env), general ? URI.parse(general) : nil, Config.client, 3, 30.seconds,
               100.milliseconds, 20.seconds, services.to_h)
  end

  # :nodoc:
  def self.nonempty(s: String?) -> String? = s && !s.empty? ? s : nil

  # :nodoc:
  CLIENT = Atom[HTTP::Client?].new(nil)

  # The client service clients use unless given another: the defaults of
  # `HTTP::Client`, but no redirect followed. Made on first use.
  def self.client -> HTTP::Client
    loop do
      made = CLIENT.get
      return made if made
      c = HTTP::Client.new(max_redirects: 0)
      return c if CLIENT.compare_and_set(made, c)
    end
  end

  # Where `service`'s requests go (`kms`): its own endpoint, else
  # `endpoint`, else `https://<service>.<region>.amazonaws.com`.
  #
  # ## Raises
  #
  # `ArgumentError` for a region that is not a host label (it would name
  # another host): `us-east-1`, not `x.example/`.
  def endpoint_for(service: String) -> URI
    unless region.match?(/\A[a-z0-9]+(-[a-z0-9]+)*\z/)
      raise ArgumentError, "not a region: #{region.inspect}"
    end
    service_endpoints[service.downcase]? || endpoint || URI.parse("https://#{service}.#{region}.amazonaws.com")
  end

  # `#<AWS::Config ap-northeast-1>`: not the credentials' state.
  def inspect -> String = "#<AWS::Config #{region}>"

  # As `inspect`.
  def to_s -> String = inspect
end
