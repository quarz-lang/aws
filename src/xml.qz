# :nodoc:
# A reader of AWS's XML answers (STS's, S3's), for the few fields the
# clients need: not a general XML parser. It reads one root element
# and the elements in it (their attributes, quoted, skipped; their
# names compared whole, prefix and all, and matched by local name),
# text with the five predefined entities and character references, an
# XML declaration and comments, and refuses anything else (a DOCTYPE,
# CDATA, a processing instruction, a stray `<` or `&`, unbalanced tags,
# text or elements outside the root), so that nothing it does not
# understand passes for an answer. Elements nest at most `MAX_DEPTH`
# deep. It reads a String already read with a bound (the answer's).
# What it refuses raises [AWS::XML::Refused], which each client turns
# into its own error.
module XML
  # The deepest elements may nest.
  MAX_DEPTH = 64

  # :nodoc:
  # What the reader does not take: the message says what, never more of
  # the document than a tag's name.
  class Refused < StandardError
  end

  # The text of every element whose local name is in `names` and whose
  # parents end with `within` (local names: `["AssumeRoleResult",
  # "Credentials"]`), by that name; the first one wins. Raises
  # [Refused] on what it does not read.
  def self.fields(xml: String, names: Array[String], within: Array[String] = []) -> Hash[String, String]
    # (Walked once, by bytes: the syntax looked for is ASCII, which never
    # occurs inside a UTF-8 sequence, so a cut there is a character
    # boundary. Indexing the String by character costs the position, and
    # made the walk quadratic in the answer's length: aws#24.)
    b = xml.to_bytes
    out = Hash::Builder[String, String].new
    stack: Array[String] = []
    text = String::Builder.new
    rooted = false
    lead = xml.bytesize - xml.lstrip.bytesize
    i = 0
    n = b.size
    while i < n
      c = b[i]
      if c == LT && i + 3 < n && b[i + 1] == BANG && b[i + 2] == DASH && b[i + 3] == DASH
        close = (b.index(b"-->", i + 4) || XML.refuse("an unterminated comment")) + 2
        i = close + 1
      elsif c == LT
        close = XML.tag_end(b, i + 1)
        tag = b.slice(i + 1, close - i - 1).decode
        if tag.start_with?("?")
          XML.refuse("a processing instruction") unless i == lead && tag.start_with?("?xml ") && tag.end_with?("?")
        elsif tag.start_with?("!")
          XML.refuse("a DOCTYPE or CDATA section")
        elsif tag.start_with?("/")
          qname = tag[1, tag.size - 1].strip
          XML.refuse("an unbalanced </#{qname}>") if stack.empty? || stack.last != qname
          stack = stack.take(stack.size - 1)
          name = XML.local(qname)
          if names.include?(name) && !out.key?(name) && XML.under?(stack, within)
            out[name] = text.to_s.strip
          end
          text = String::Builder.new
        else
          empty = tag.end_with?("/")
          body = empty ? tag[0, tag.size - 1] : tag
          qname = body.split(/\s/)[0]? || ""
          XML.refuse("an element without a name") if qname.empty?
          XML.refuse("a second root element") if stack.empty? && rooted
          rooted = true
          if empty
            name = XML.local(qname)
            out[name] = "" if names.include?(name) && !out.key?(name) && XML.under?(stack, within)
          else
            stack = stack.push(qname)
            XML.refuse("elements nested deeper than #{MAX_DEPTH}") if stack.size > MAX_DEPTH
          end
          text = String::Builder.new
        end
        i = close + 1
      elsif c == AMP
        semi = b.index(b";", i) || XML.refuse("an unterminated entity")
        XML.refuse("an entity outside the root") if stack.empty?
        text << XML.entity(b.slice(i + 1, semi - i - 1).decode)
        i = semi + 1
      else
        # The text up to the next `<` or `&`, at once.
        j = i
        j += 1 while j < n && b[j] != LT && b[j] != AMP
        run = b.slice(i, j - i).decode
        XML.refuse("text outside the root") if stack.empty? && !run.strip.empty?
        text << run
        i = j
      end
    end
    XML.refuse("no root element") unless rooted
    XML.refuse("unclosed elements") unless stack.empty?
    out.to_h
  end

  # :nodoc:
  # Bytes the reader looks for.
  LT = 60
  GT = 62
  AMP = 38
  BANG = 33
  DASH = 45
  QUOT = 34
  APOS = 39

  # :nodoc:
  # Where the tag that starts at `from` (after its `<`) ends: its `>`
  # outside quoted attribute values (a byte index of `b`).
  def self.tag_end(b: Bytes, from: Int) -> Int
    quote = -1
    i = from
    while i < b.size
      c = b[i]
      if quote >= 0
        quote = -1 if c == quote
      elsif c == QUOT || c == APOS
        quote = c
      elsif c == LT
        XML.refuse("a `<` in a tag")
      elsif c == GT
        return i
      end
      i += 1
    end
    XML.refuse("an unterminated tag")
  end

  # :nodoc:
  # Whether the parents' local names end with `within`.
  def self.under?(stack: Array[String], within: Array[String]) -> Bool
    return true if within.empty?
    return false if stack.size < within.size
    stack.drop(stack.size - within.size).map { |q| XML.local(q) } == within
  end

  # :nodoc:
  def self.refuse(what: String) -> Nothing
    raise Refused.new(what)
  end

  # :nodoc:
  def self.local(name: String) -> String
    _, _, after = name.rpartition(":")
    after
  end

  # :nodoc:
  def self.entity(name: String) -> String
    case name
    in "lt" then "<"
    in "gt" then ">"
    in "amp" then "&"
    in "quot" then "\""
    in "apos" then "'"
    else
      code = if name.match?(/\A#x[0-9A-Fa-f]{1,6}\z/) then name[2, name.size - 2].to_i(16)
             elsif name.match?(/\A#[0-9]{1,7}\z/) then name[1, name.size - 1].to_i
             else nil
             end
      if code.nil? || code <= 0 || code > 0x10FFFF || (code >= 0xD800 && code <= 0xDFFF)
        XML.refuse("the entity &#{name};")
      end
      code.chr
    end
  end
end
