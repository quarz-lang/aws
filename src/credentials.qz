require "http"
require "json"
require "uri"

# No credentials could be had: no provider of a chain answered, a
# provider's source said no, or temporary keys expired and could not be
# refreshed. The message says what was tried; it never holds a key.
class CredentialsError < Error
end

# The keys of the profile named by AWS_PROFILE (or given) could not be
# had (a source this cog does not read, a role that could not be
# assumed): a chain stops there, rather than find other keys than those
# asked for.
class ProfileError < CredentialsError
end

# The profile named by AWS_PROFILE (or given) is in neither shared file:
# a chain stops there, rather than find other keys than those asked for.
class ProfileNotFound < ProfileError
end

# AWS credentials: access keys (`Keys`), and the providers that find
# them, as the SDKs do (`Credentials.default`).
#
# ```
# creds = AWS::Credentials.static(access_key_id: "AKIDEXAMPLE", secret_access_key: "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY")
# creds.get.access_key_id   # => "AKIDEXAMPLE"
# creds.get.inspect         # => "#<AWS::Credentials::Keys AKIDEXAMPLE>"
# ```
module Credentials
  # Temporary keys are refreshed this long before they expire.
  REFRESH_MARGIN = 5.minutes

  # Access keys: an access key id and its secret, with a session token
  # and an expiry for temporary ones. `inspect` and `to_s` show the
  # access key id and the expiry only: never the secret nor the token.
  data Keys(
    # The access key id (`AKIA...`, `ASIA...` for temporary keys).
    access_key_id: String,
    # The secret access key.
    secret_access_key: String,
    # The session token of temporary keys.
    session_token: String? = nil,
    # When temporary keys expire.
    expires_at: Time? = nil
  )
    # `#<AWS::Credentials::Keys AKIDEXAMPLE>`, with the expiry when there
    # is one.
    def inspect -> String
      e = expires_at
      e ? "#<AWS::Credentials::Keys #{access_key_id} expires #{e.utc.iso8601}>" : "#<AWS::Credentials::Keys #{access_key_id}>"
    end

    # As `inspect`.
    def to_s -> String = inspect

    # Whether they are to be refreshed at `now`: within `margin` of
    # their expiry (never, without one).
    def stale?(now: Time, margin: Duration = REFRESH_MARGIN) -> Bool
      e = expires_at
      !e.nil? && now + margin >= e
    end

    # Whether they have expired at `now`.
    def expired?(now: Time) -> Bool = stale?(now, 0.seconds)
  end

  # A source of keys: `get` gives them, or raises `CredentialsError`.
  # Providers are Shareable: one can be kept in a constant and used from
  # any task.
  module Provider
    include Shareable

    # The keys, or `CredentialsError`.
    abstract def get -> Keys

    # What it is, for messages: `environment`, `profile default`.
    abstract def name -> String
  end

  # Keys given in the program.
  def self.static(*, access_key_id: String, secret_access_key: String, session_token: String? = nil) -> Provider
    Static.new(Keys.new(access_key_id, secret_access_key, session_token, nil))
  end

  # The keys of the environment: AWS_ACCESS_KEY_ID,
  # AWS_SECRET_ACCESS_KEY and AWS_SESSION_TOKEN (`env` is `ENV`
  # unless a test gives another).
  def self.env(env: Hash[String, String] = ENV) -> Provider = Env.new(env)

  # The keys of profile `name` in the shared files: `~/.aws/credentials`
  # (AWS_SHARED_CREDENTIALS_FILE) and `~/.aws/config`
  # (AWS_CONFIG_FILE, its sections `[profile name]`), the first one's
  # settings winning. A profile with `role_arn` and `source_profile` is
  # the role's temporary keys, from STS AssumeRole signed with the
  # source profile's own keys (one level), cached and refreshed.
  def self.profile(name: String? = nil, *, env: Hash[String, String] = ENV,
                   http: HTTP::Client = Credentials.sts_client) -> Provider
    from_env = env["AWS_PROFILE"]?
    named = name || (from_env && !from_env.empty? ? from_env : nil)
    Cached.new(ProfileKeys.new(named || "default", !named.nil?, env, http))
  end

  # The keys of an ECS task or an EKS Pod Identity: from
  # AWS_CONTAINER_CREDENTIALS_RELATIVE_URI (against `base`,
  # `http://169.254.170.2`, which tests replace) or
  # AWS_CONTAINER_CREDENTIALS_FULL_URI (https on any host, http only on
  # loopback, `169.254.170.2` or `fd00:ec2::23`), with
  # AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE (read each time) or
  # AWS_CONTAINER_AUTHORIZATION_TOKEN as the Authorization header.
  # Cached and refreshed.
  def self.container(*, env: Hash[String, String] = ENV, base: String = "http://169.254.170.2",
                     http: HTTP::Client = Credentials.local_client) -> Provider
    Cached.new(Container.new(env, base, http))
  end

  # The keys of an EC2 instance's role, from its metadata service
  # (IMDSv2: a token PUT, then the role's name and keys), at `base`
  # (AWS_EC2_METADATA_SERVICE_ENDPOINT, else
  # `http://169.254.169.254`; tests replace it); none when
  # AWS_EC2_METADATA_DISABLED is `true`. One attempt with 1-second
  # timeouts, so that a chain off EC2 moves on. Cached and refreshed.
  def self.instance(*, env: Hash[String, String] = ENV, base: String? = nil,
                    http: HTTP::Client = Credentials.metadata_client) -> Provider
    b = base || env["AWS_EC2_METADATA_SERVICE_ENDPOINT"]? || "http://169.254.169.254"
    Cached.new(Instance.new(env, b, http))
  end

  # The keys of a role assumed with a web identity token (EKS IRSA,
  # GitHub Actions' OIDC): STS AssumeRoleWithWebIdentity, unsigned,
  # with the token of AWS_WEB_IDENTITY_TOKEN_FILE (read at each
  # refresh), AWS_ROLE_ARN and AWS_ROLE_SESSION_NAME; STS's regional
  # endpoint for AWS_REGION/AWS_DEFAULT_REGION (the global one
  # without), or `endpoint`. Cached and refreshed.
  def self.web_identity(*, env: Hash[String, String] = ENV, endpoint: String? = nil,
                        http: HTTP::Client = Credentials.sts_client) -> Provider
    Cached.new(WebIdentity.new(env, endpoint, http))
  end

  # The first of `providers` that answers, tried in order; the one that
  # answered is tried first afterwards. Raises `CredentialsError` naming
  # what each said when none does.
  def self.chain(providers: Array[Provider]) -> Provider
    raise ArgumentError, "a chain of no provider" if providers.empty?
    Chain.new(providers, Atom[Int?].new(nil))
  end

  # The SDKs' chain: `env`, `web_identity`, `profile`, `container`,
  # `instance`.
  def self.default(env: Hash[String, String] = ENV) -> Provider
    chain([Credentials.env(env), web_identity(env: env), profile(env: env), container(env: env), instance(env: env)])
  end

  # :nodoc:
  # A client for link-local endpoints (the container's and the
  # instance's): never through a proxy. None of the clients here follows
  # redirects (as the SDKs): a redirect would take tokens elsewhere, and
  # around the container's allowed hosts.
  def self.local_client -> HTTP::Client = HTTP::Client.new(timeout: 5.seconds, connect_timeout: 2.seconds, proxy: nil, max_redirects: 0)

  # :nodoc:
  def self.metadata_client -> HTTP::Client
    HTTP::Client.new(timeout: 1.second, connect_timeout: 1.second, read_timeout: 1.second, proxy: nil, max_redirects: 0)
  end

  # :nodoc:
  # A client for STS: bounded, so that a refresh never hangs a request.
  def self.sts_client -> HTTP::Client = HTTP::Client.new(timeout: 10.seconds, max_redirects: 0)

  # :nodoc:
  # The block's value; an error other than `CredentialsError` (a URL or
  # a header the environment made wrong, an answer the client could not
  # read) raised as one, so that a chain moves on and a cache keeps its
  # keys.
  def self.guard(what: String, &: () -> Keys) -> Keys
    yield
  rescue CredentialsError => e
    raise e
  rescue ArgumentError
    # (Its message may hold the URL or the value the environment gave.)
    raise CredentialsError.new("#{what}: a URL or a header from the environment is not valid (ArgumentError)")
  rescue StandardError => e
    raise CredentialsError.new("#{what}: #{e.class.name}: #{e.message}")
  end

  # :nodoc:
  data Static(keys: Keys)
    include Provider

    # `#<AWS::Credentials environment>`: what it is, not what it holds
    # (an environment's or a cache's secrets).
    def inspect -> String = "#<AWS::Credentials #{name}>"

    # As `inspect`.
    def to_s -> String = inspect

    def get -> Keys = keys
    def name -> String = "static keys"
  end

  # :nodoc:
  data Env(env: Hash[String, String])
    include Provider

    # `#<AWS::Credentials environment>`: what it is, not what it holds
    # (an environment's or a cache's secrets).
    def inspect -> String = "#<AWS::Credentials #{name}>"

    # As `inspect`.
    def to_s -> String = inspect

    def get -> Keys
      id = env["AWS_ACCESS_KEY_ID"]?
      secret = env["AWS_SECRET_ACCESS_KEY"]?
      if id.nil? || id.empty? || secret.nil? || secret.empty?
        raise CredentialsError.new("AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are not both set")
      end
      token = env["AWS_SESSION_TOKEN"]?
      Keys.new(id, secret, token && !token.empty? ? token : nil, nil)
    end

    def name -> String = "environment"
  end

  # :nodoc:
  # Keys kept until they are stale, then refreshed by one task at a
  # time: the others go on with the kept keys while they have not
  # expired. A refresh that fails keeps the old keys until they expire,
  # and is not tried again for `RETRY_AFTER`.
  data Cached(inner: Provider, keys: Atom[Keys?] = Atom[Keys?].new(nil), refreshing: Atom[Bool] = Atom.new(false),
              tried_at: Atom[Time?] = Atom[Time?].new(nil), failure: Atom[String?] = Atom[String?].new(nil),
              failure_kind: Atom[Int] = Atom.new(0))
    include Provider

    # `#<AWS::Credentials environment>`: what it is, not what it holds
    # (an environment's or a cache's secrets).
    def inspect -> String = "#<AWS::Credentials #{name}>"

    # As `inspect`.
    def to_s -> String = inspect

    # How long a refresh is not tried again while the old keys last:
    # after a failure, or keys that came already stale.
    RETRY_AFTER = 10.seconds
    # How long a task waits for another's refresh before making its own.
    WAIT_AT_MOST = 15.seconds

    def get -> Keys
      now = Time.now
      kept = keys.get
      return kept if kept && !kept.stale?(now)
      usable = kept && !kept.expired?(now) ? kept : nil
      if u = usable
        f = tried_at.get
        return u if f && now - f < RETRY_AFTER
      end
      claimed = false
      loop do
        claimed = refreshing.compare_and_set(false, true)
        break if claimed
        if u = usable
          return u
        end
        # (None to go on with: the other task's keys, once it is done;
        # its failure, when it failed; else a refresh of its own, claimed
        # in turn. Past `WAIT_AT_MOST`, one unclaimed.)
        got, timed_out = wait_for_refresh
        if g = got
          return g
        end
        break if timed_out
        f = tried_at.get
        m = failure.get
        raise Cached.error(failure_kind.get, m) if f && m && Time.now - f < RETRY_AFTER
      end
      begin
        fresh = Credentials.guard(inner.name) { inner.get }
        raise CredentialsError.new("#{inner.name} gave keys that have expired") if fresh.expired?(Time.now)
        keys.set(fresh)
        tried_at.set(fresh.stale?(Time.now) ? Time.now : nil)
        failure.set(nil)
        fresh
      rescue CredentialsError => e
        tried_at.set(Time.now)
        failure_kind.set(e.is_a?(ProfileNotFound) ? 2 : e.is_a?(ProfileError) ? 1 : 0)
        failure.set(e.message)
        if u = usable
          return u
        end
        raise e
      ensure
        refreshing.set(false) if claimed
      end
    end

    # The keys another task's refresh brought (nil when it brought none),
    # and whether it took longer than `WAIT_AT_MOST`.
    private def wait_for_refresh -> [Keys?, Bool]
      deadline = Time.monotonic + WAIT_AT_MOST
      while refreshing.get
        return [nil, true] if Time.monotonic >= deadline
        Task.sleep(5.milliseconds)
      end
      k = keys.get
      [k && !k.expired?(Time.now) ? k : nil, false]
    end

    # :nodoc:
    # The error a waiter raises for the refresher's failure: of its class
    # (a `ProfileError` stops a chain).
    def self.error(kind: Int, message: String) -> CredentialsError
      case kind
      in 2 then ProfileNotFound.new(message)
      in 1 then ProfileError.new(message)
      else CredentialsError.new(message)
      end
    end

    def name -> String = inner.name
  end

  # :nodoc:
  data Chain(providers: Array[Provider], found: Atom[Int?])
    include Provider

    # `#<AWS::Credentials environment>`: what it is, not what it holds
    # (an environment's or a cache's secrets).
    def inspect -> String = "#<AWS::Credentials #{name}>"

    # As `inspect`.
    def to_s -> String = inspect

    def get -> Keys
      order: Array[Int] = []
      if f = found.get
        order = order.push(f)
      end
      providers.each_with_index { |_, i| order = order.push(i) unless order.include?(i) }
      failures: Array[String] = []
      order.each do |i|
        begin
          k = Credentials.guard(providers[i].name) { providers[i].get }
          found.set(i)
          return k
        rescue ProfileError => e
          raise e
        rescue CredentialsError => e
          failures = failures.push("#{providers[i].name}: #{e.message}")
        end
      end
      raise CredentialsError.new("no credentials: #{failures.join("; ")}")
    end

    def name -> String = "chain"
  end

  # :nodoc:
  data ProfileKeys(profile: String, named: Bool, env: Hash[String, String], http: HTTP::Client)
    include Provider

    # `#<AWS::Credentials environment>`: what it is, not what it holds
    # (an environment's or a cache's secrets).
    def inspect -> String = "#<AWS::Credentials #{name}>"

    # As `inspect`.
    def to_s -> String = inspect

    # A named profile's failure is a `ProfileError`, which stops a chain.
    def get -> Keys
      return keys unless named
      begin
        keys
      rescue ProfileError => e
        raise e
      rescue CredentialsError => e
        raise ProfileError.new(e.message)
      rescue ArgumentError
        raise ProfileError.new("profile #{profile}: a setting is not valid (ArgumentError)")
      rescue StandardError => e
        raise ProfileError.new("profile #{profile}: #{e.class.name}: #{e.message}")
      end
    end

    private def keys -> Keys
      s = Profiles.settings(profile, env)
      if s.nil?
        raise ProfileNotFound.new("no profile #{profile}") if named
        raise CredentialsError.new("no profile #{profile}")
      end
      role = s["role_arn"]?
      # (A role, when there is one, as the SDKs: before the profile's
      # own keys, which may be its source's.)
      if role.nil?
        own = Profiles.keys(s)
        return own if own
        raise CredentialsError.new("profile #{profile} has neither keys nor role_arn and source_profile")
      end
      source = s["source_profile"]?
      raise CredentialsError.new("profile #{profile} has role_arn without source_profile") if source.nil?
      src = source == profile ? s.reject { |k, _| k == "role_arn" } : Profiles.settings(source, env)
      raise CredentialsError.new("no profile #{source} (the source_profile of #{profile})") if src.nil?
      src_keys = Profiles.keys(src)
      if src_keys.nil?
        why = src.key?("role_arn") ? "assumes a role itself (one level only)" : "has no keys of its own"
        raise CredentialsError.new("profile #{source}, the source_profile of #{profile}, #{why}")
      end
      region = env["AWS_REGION"]? || env["AWS_DEFAULT_REGION"]? || s["region"]? || src["region"]?
      params = {"Action" => "AssumeRole", "Version" => "2011-06-15", "RoleArn" => role,
                "RoleSessionName" => s["role_session_name"]? || STS.session_name}
      if x = s["external_id"]?
        params = params.merge({"ExternalId" => x})
      end
      if d = s["duration_seconds"]?
        params = params.merge({"DurationSeconds" => d})
      end
      STS.assume(http, STS.endpoint(region, env), params, "AssumeRoleResult", src_keys, region)
    end

    def name -> String = "profile #{profile}"
  end

  # :nodoc:
  data Container(env: Hash[String, String], base: String, http: HTTP::Client)
    include Provider

    # `#<AWS::Credentials environment>`: what it is, not what it holds
    # (an environment's or a cache's secrets).
    def inspect -> String = "#<AWS::Credentials #{name}>"

    # As `inspect`.
    def to_s -> String = inspect

    def get -> Keys
      url = Container.url(env, base)
      req = HTTP::Client::Request.get(url)
      if file = env["AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE"]?
        token = begin
                  File.read(file).strip
                rescue IOError, SystemCallError => e
                  raise CredentialsError.new("cannot read AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE #{file}: #{e.class.name}")
                end
        req = req.header("authorization", token)
      elsif given = env["AWS_CONTAINER_AUTHORIZATION_TOKEN"]?
        req = req.header("authorization", given)
      end
      Credentials.json_keys(Credentials.fetch(http, req, "the container endpoint"), "the container endpoint")
    end

    def name -> String = "container"

    # The endpoint, or `CredentialsError` when there is none or a full URI
    # names a host it may not.
    def self.url(env: Hash[String, String], base: String) -> URI
      if rel = env["AWS_CONTAINER_CREDENTIALS_RELATIVE_URI"]?
        return URI.parse("#{base}#{rel.start_with?("/") ? rel : "/#{rel}"}")
      end
      full = env["AWS_CONTAINER_CREDENTIALS_FULL_URI"]?
      raise CredentialsError.new("AWS_CONTAINER_CREDENTIALS_RELATIVE_URI and _FULL_URI are not set") if full.nil?
      u = begin
            URI.parse(full)
          rescue ArgumentError
            raise CredentialsError.new("AWS_CONTAINER_CREDENTIALS_FULL_URI is not a URI")
          end
      scheme = u.scheme.downcase
      return u if scheme == "https" && !(u.host || "").empty?
      unless scheme == "http" && Container.allowed_host?(u.host || "")
        raise CredentialsError.new("AWS_CONTAINER_CREDENTIALS_FULL_URI over http must name a loopback address, 169.254.170.2 or fd00:ec2::23")
      end
      u
    end

    # Loopback (`127.0.0.0/8`, `::1`, `localhost`), ECS's `169.254.170.2`,
    # EKS Pod Identity's `169.254.170.23` and `fd00:ec2::23`.
    def self.allowed_host?(host: String) -> Bool
      h = host.downcase
      return true if h == "localhost" || h == "169.254.170.2" || h == "169.254.170.23"
      addr = HTTP.ip_bytes(h)
      return false if addr.nil?
      return addr[0] == 127 if addr.size == 4
      addr == HTTP.ip_bytes("::1") || addr == HTTP.ip_bytes("fd00:ec2::23")
    end
  end

  # :nodoc:
  data Instance(env: Hash[String, String], base: String, http: HTTP::Client)
    include Provider

    # `#<AWS::Credentials environment>`: what it is, not what it holds
    # (an environment's or a cache's secrets).
    def inspect -> String = "#<AWS::Credentials #{name}>"

    # As `inspect`.
    def to_s -> String = inspect

    # The token's lifetime asked for, in seconds.
    TOKEN_TTL = "21600"

    def get -> Keys
      if (env["AWS_EC2_METADATA_DISABLED"]? || "").downcase == "true"
        raise CredentialsError.new("AWS_EC2_METADATA_DISABLED is true")
      end
      put = HTTP::Client::Request.new("PUT", "#{base}/latest/api/token",
                                      headers: {"X-aws-ec2-metadata-token-ttl-seconds" => TOKEN_TTL})
      token = Credentials.fetch(http, put, "the instance metadata service").strip
      path = "#{base}/latest/meta-data/iam/security-credentials/"
      roles = Credentials.fetch(http, HTTP::Client::Request.get(path, {"X-aws-ec2-metadata-token" => token}), "the instance metadata service")
      role = roles.split("\n").map(&:strip).find { |r| !r.empty? }
      raise CredentialsError.new("the instance has no role") if role.nil?
      body = Credentials.fetch(http, HTTP::Client::Request.get("#{path}#{URI.encode_component(role)}", {"X-aws-ec2-metadata-token" => token}),
                               "the instance metadata service")
      Credentials.json_keys(body, "the instance metadata service")
    end

    def name -> String = "instance"
  end

  # :nodoc:
  data WebIdentity(env: Hash[String, String], endpoint: String?, http: HTTP::Client)
    include Provider

    # `#<AWS::Credentials environment>`: what it is, not what it holds
    # (an environment's or a cache's secrets).
    def inspect -> String = "#<AWS::Credentials #{name}>"

    # As `inspect`.
    def to_s -> String = inspect

    def get -> Keys
      file = env["AWS_WEB_IDENTITY_TOKEN_FILE"]?
      role = env["AWS_ROLE_ARN"]?
      if file.nil? || file.empty? || role.nil? || role.empty?
        raise CredentialsError.new("AWS_WEB_IDENTITY_TOKEN_FILE and AWS_ROLE_ARN are not both set")
      end
      token = begin
                File.read(file).strip
              rescue IOError, SystemCallError => e
                raise CredentialsError.new("cannot read AWS_WEB_IDENTITY_TOKEN_FILE #{file}: #{e.class.name}")
              end
      region = env["AWS_REGION"]? || env["AWS_DEFAULT_REGION"]?
      url = endpoint || STS.endpoint(region, env)
      params = {"Action" => "AssumeRoleWithWebIdentity", "Version" => "2011-06-15", "RoleArn" => role,
                "RoleSessionName" => env["AWS_ROLE_SESSION_NAME"]? || STS.session_name, "WebIdentityToken" => token}
      STS.assume(http, url, params, "AssumeRoleWithWebIdentityResult", nil, region)
    end

    def name -> String = "web identity"
  end

  # :nodoc:
  # The body of `req`'s answer, or `CredentialsError` (`what` answered
  # otherwise, or could not be reached).
  def self.fetch(http: HTTP::Client, req: HTTP::Client::Request, what: String) -> String
    status, body = begin
                     res = http.request(req)
                     [res.status, res.body.read]
                   rescue HTTP::Client::Error => e
                     raise CredentialsError.new("#{what} could not be reached (#{e.class.name}: #{e.message})")
                   end
    raise CredentialsError.new("#{what} answered #{status}") unless status >= 200 && status <= 299
    body
  end

  # :nodoc:
  # Keys from the JSON the container and instance endpoints answer
  # (`AccessKeyId`, `SecretAccessKey`, `Token`, `Expiration`).
  def self.json_keys(body: String, what: String) -> Keys
    doc = begin
            JSON.parse(body)
          rescue JSON::ParseError
            raise CredentialsError.new("#{what} answered something that is not JSON")
          end
    id = doc["AccessKeyId"]?&.as_s?
    secret = doc["SecretAccessKey"]?&.as_s?
    if id.nil? || secret.nil? || id.empty? || secret.empty?
      code = doc["Code"]?&.as_s? || "no keys"
      raise CredentialsError.new("#{what} answered without keys (#{code})")
    end
    exp: String? = nil
    if e = doc["Expiration"]?
      exp = e.as_s? || raise CredentialsError.new("#{what} answered an expiry that is not a time")
    end
    token: String? = nil
    if t = doc["Token"]?
      token = t.as_s? || raise CredentialsError.new("#{what} answered a token that is not a string")
    end
    Keys.new(id, secret, token, exp ? Credentials.time(exp, what) : nil)
  end

  # :nodoc:
  def self.time(text: String, what: String) -> Time
    Time.iso8601(text)
  rescue ArgumentError
    raise CredentialsError.new("#{what} answered an expiry that is not a time: #{text.inspect}")
  end
end
