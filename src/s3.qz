require "http"
require "digest"
require "base64"

# Amazon S3: objects written to a bucket. Shareable: one per program,
# used from any task. Made from a [Config] (region, credentials, and an
# endpoint override for a local stand-in or an S3-compatible store),
# built on the same transport as [AWS::KMS]: each attempt signed (SigV4,
# the payload's SHA-256 signed, never `UNSIGNED-PAYLOAD`) and sent under
# `config.timeout`, its answer read with a bound, throttling (`SlowDown`,
# 503), 5xx answers, S3's `RequestTimeout` and transport errors tried
# again with backoff, the clock corrected once for
# `RequestTimeTooSkewed`. No redirect is followed.
#
# Addressing: virtual-hosted (`https://{bucket}.s3.{region}.amazonaws.com/{key}`)
# by default; path style (`https://s3.{region}.amazonaws.com/{bucket}/{key}`)
# for a bucket name with a dot (the wildcard certificate does not cover
# it; AWS calls path style legacy, and keeps it working); and path style
# at the endpoint when the config overrides it (`endpoint:`, or
# `AWS_ENDPOINT_URL_S3`). Each segment of the key is percent-encoded
# once, as SigV4 signs it for `s3`; nothing removes `.` or `..` segments
# or merges slashes, so the request names exactly the key given.
#
# A large object: one PUT carries up to 5 GB, held in memory as one
# [Bytes] and sent within `config.timeout` per attempt: raise the
# timeout in the [Config] for large objects.
#
# ```
# creds = AWS::Credentials.static(access_key_id: "AKIDEXAMPLE", secret_access_key: "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY")
# s3 = AWS::S3.new(AWS::Config.new(region: "eu-west-1", credentials: creds))
# s3.inspect   # => "#<AWS::S3 eu-west-1>"
# ```
class S3
  include Shareable

  # A checksum S3 gave: its algorithm (`:sha256`, `:sha1`, `:crc32`,
  # `:crc32c`, `:crc64nvme`) and its value as S3 writes it (base64).
  data Checksum = (algorithm: Symbol, value: String)

  # `put_object`'s answer: the object's ETag (as S3 gives it, quoted),
  # its version id (nil when the bucket has no versioning), and the
  # checksum S3 gave back (nil when it gave none).
  data PutObjectOutput = (etag: String, version_id: String?, checksum: Checksum?)

  # `get_object`'s answer: the body, and what [HeadObjectOutput] has.
  # [checksum] is the one S3 gave (asked with `x-amz-checksum-mode:
  # ENABLED`); [checksum_verified] is true when it was checked against
  # the body and matched: a SHA-256 of the whole object. A checksum of
  # another algorithm (the standard library has no CRC32, CRC32C,
  # CRC64NVME or SHA-1), or of a multipart upload's parts (a checksum of
  # checksums, `...-N`), is not checked: false, never a mismatch.
  data GetObjectOutput(body: Bytes, content_type: String?, etag: String, version_id: String?, last_modified: Time?,
                          metadata: Hash[String, String], object_lock_mode: Symbol?, object_lock_retain_until_date: Time?,
                          object_lock_legal_hold: Bool?, checksum: Checksum?, checksum_verified: Bool)
    # Without the body: its size only.
    def inspect -> String
      "#<AWS::S3::GetObjectOutput #{body.size} bytes, etag: #{etag}, version_id: #{version_id.inspect}>"
    end

    # As [inspect].
    def to_s -> String = inspect
  end

  # `head_object`'s answer: the object's size (`Content-Length`), content
  # type, ETag, version id, last modification, metadata (`x-amz-meta-*`,
  # by name lowercased, without the prefix), its Object Lock mode
  # (`:governance`, `:compliance`), retention date and legal hold, and
  # the checksum S3 gave (not checked: there is no body).
  data HeadObjectOutput = (content_length: Int, content_type: String?, etag: String, version_id: String?, last_modified: Time?,
                           metadata: Hash[String, String], object_lock_mode: Symbol?, object_lock_retain_until_date: Time?,
                           object_lock_legal_hold: Bool?, checksum: Checksum?)

  # An object of a listing ([S3#list_objects_v2]): its key (decoded:
  # exactly the key), size in bytes, ETag (as S3 gives it, quoted) and
  # last modification.
  data ObjectSummary = (key: String, size: Int, etag: String, last_modified: Time?)

  # `list_objects_v2`'s answer: the page's objects, in S3's order (by
  # key, UTF-8 bytes), and the token for the next page (nil on the last).
  data ListObjectsV2Output = (objects: Array[ObjectSummary], next_continuation_token: String?)

  # `get_object`'s object is larger than its `max_bytes`: raised from
  # its `Content-Length` before the body is read (or while reading, past
  # the bound), not tried again.
  class ObjectTooLarge < Error
  end

  # The body `get_object` read does not match the checksum S3 gave for
  # it (neither value is in the message). Not tried again.
  class ChecksumMismatch < Error
  end

  # The bucket is in another region than the request's: S3 answered 301
  # `PermanentRedirect` or 400 `AuthorizationHeaderMalformed`, which is
  # raised rather than followed. [region] is the bucket's, when S3 said
  # it (`x-amz-bucket-region`, or the error's `Region`).
  class WrongRegion < ServiceError
    @region: String?

    # The error, with the bucket's [region].
    def initialize(*, code: String, message: String, status: Int, request_id: String? = nil, region: String? = nil)
      @region = region
      super(code: code, message: message, status: status, request_id: request_id)
    end

    # The bucket's region, when S3 said it.
    def region -> String? = @region
  end

  # The most bytes read of an answer that is a document (an error, or
  # `put_object`'s empty body).
  ANSWER_LIMIT = 65_536
  # The most bytes read of a listing: a full page (1000 keys of up to
  # 1024 bytes, each byte encoded as `%XX`, with their sizes, ETags,
  # dates and storage classes) is under 4 MiB.
  LIST_LIMIT = 4 * 1024 * 1024
  # The codes tried again, besides the 5xx statuses and 429 (S3's
  # `RequestTimeout` is a 400 the SDKs try again).
  RETRIED_CODES = ["SlowDown", "InternalError", "ServiceUnavailable", "RequestTimeout"]
  # The codes that may mean the request's time is too far from the
  # server's (corrected only when the server's Date says so).
  SKEW_CODES = ["RequestTimeTooSkewed"]
  # The checksums S3 may give back, by header (in the order looked at:
  # the one sent first).
  CHECKSUM_HEADERS = {sha256: "x-amz-checksum-sha256", crc64nvme: "x-amz-checksum-crc64nvme", crc32: "x-amz-checksum-crc32",
                      crc32c: "x-amz-checksum-crc32c", sha1: "x-amz-checksum-sha1"}

  @config: Config
  # The endpoint the config overrides, if any: path style there.
  @override: URI?
  @transport: Transport

  # A client for `config`'s region and credentials.
  def initialize(@config: Config)
    @override = config.service_endpoints["s3"]? || config.endpoint
    @transport = Transport.new(config, "s3", RETRIED_CODES, SKEW_CODES)
  end

  # The configuration.
  def config -> Config = @config

  # `#<AWS::S3 eu-west-1>` (and the endpoint, when overridden): not the
  # credentials' state.
  def inspect -> String
    if o = @override
      "#<AWS::S3 #{@config.region} #{o}>"
    else
      "#<AWS::S3 #{@config.region}>"
    end
  end

  # As [inspect].
  def to_s -> String = inspect

  # Writes `body` as the object `key` of `bucket`, in one PUT.
  #
  # - A checksum is always sent: `x-amz-checksum-sha256` (with
  #   `x-amz-sdk-checksum-algorithm: SHA256`) by default, `Content-MD5`
  #   with `checksum: :md5`; S3 refuses a PUT to a bucket with Object
  #   Lock that has neither. The payload is signed too.
  # - Object Lock: `object_lock_mode` (`:governance` or `:compliance`)
  #   with `object_lock_retain_until_date`, both or neither;
  #   `object_lock_legal_hold`.
  # - `server_side_encryption` (`:aes256` or `:aws_kms`, with
  #   `ssekms_key_id` for the latter only); `expected_bucket_owner` (an
  #   account id: S3 refuses the PUT when the bucket is another's);
  #   `metadata`, sent as `x-amz-meta-<name>`: names are header tokens,
  #   values ASCII without control characters.
  #
  # A PUT tried again after an answer that was lost (a 5xx, a timeout, a
  # connection dropped after the body was sent) may have been written
  # twice: with versioning, which Object Lock requires, that is two
  # versions of the object, and under a retention both stay. A caller
  # that must not write twice sets `retries: 0` in the [Config].
  #
  # ## Raises
  #
  # [ArgumentError] before anything is sent, for a bucket name S3's
  # rules refuse, an option outside its symbols, a lock mode without a
  # date (or the reverse), a KMS key without `:aws_kms`, an owner that is
  # not 12 digits, a metadata name or value that cannot be a header (the
  # message names the key, never the value), or another header value
  # with a control character. [WrongRegion] when the bucket is in
  # another region; [ServiceError] for S3's other errors (match on
  # `code`: `AccessDenied`, `NoSuchBucket`, `InvalidRequest`, ...);
  # [TransportError] when no answer came.
  def put_object(*, bucket: String, key: String, body: Bytes | String, content_type: String? = nil, checksum: Symbol = :sha256,
                 object_lock_mode: Symbol? = nil, object_lock_retain_until_date: Time? = nil, object_lock_legal_hold: Bool? = nil,
                 server_side_encryption: Symbol? = nil, ssekms_key_id: String? = nil, expected_bucket_owner: String? = nil,
                 metadata: Hash[String, String] = Hash[String, String].new) -> PutObjectOutput
    req = put_request(bucket: bucket, key: key, body: body, content_type: content_type, checksum: checksum,
                      object_lock_mode: object_lock_mode, object_lock_retain_until_date: object_lock_retain_until_date,
                      object_lock_legal_hold: object_lock_legal_hold, server_side_encryption: server_side_encryption,
                      ssekms_key_id: ssekms_key_id, expected_bucket_owner: expected_bucket_owner, metadata: metadata)
    answer = @transport.send(req, "S3 PutObject", ANSWER_LIMIT, ->(status: Int, h: HTTP::Headers, text: String) { S3.error(status, h, text) })
    h = answer.headers
    PutObjectOutput.new(h["etag"] || "", h["x-amz-version-id"], S3.checksum_of(h))
  end

  # :nodoc:
  # The unsigned request `put_object` sends (signed at each attempt),
  # its arguments checked.
  def put_request(*, bucket: String, key: String, body: Bytes | String, content_type: String? = nil, checksum: Symbol = :sha256,
                  object_lock_mode: Symbol? = nil, object_lock_retain_until_date: Time? = nil, object_lock_legal_hold: Bool? = nil,
                  server_side_encryption: Symbol? = nil, ssekms_key_id: String? = nil, expected_bucket_owner: String? = nil,
                  metadata: Hash[String, String] = Hash[String, String].new) -> HTTP::Client::Request
    S3.check_bucket(bucket)
    data = body.is_a?(String) ? body.as(String).to_bytes : body.as(Bytes)
    headers = HTTP::Headers.empty
    case checksum
    in :sha256
      headers = headers.put("x-amz-checksum-sha256", Base64.encode(Digest::SHA256.digest(data)))
                       .put("x-amz-sdk-checksum-algorithm", "SHA256")
    in :md5
      headers = headers.put("content-md5", Base64.encode(Digest::MD5.digest(data)))
    else
      raise ArgumentError.new("checksum: :sha256 or :md5, not #{checksum.inspect}")
    end
    if t = content_type
      headers = headers.put("content-type", t)
    end
    mode = object_lock_mode
    until_date = object_lock_retain_until_date
    if mode.nil? != until_date.nil?
      raise ArgumentError.new("object_lock_mode and object_lock_retain_until_date go together")
    end
    if (m = mode) && (d = until_date)
      text = case m
             in :governance then "GOVERNANCE"
             in :compliance then "COMPLIANCE"
             else raise ArgumentError.new("object_lock_mode: :governance or :compliance, not #{m.inspect}")
             end
      headers = headers.put("x-amz-object-lock-mode", text).put("x-amz-object-lock-retain-until-date", S3.timestamp(d))
    end
    if (hold = object_lock_legal_hold).is_a?(Bool)
      headers = headers.put("x-amz-object-lock-legal-hold", hold ? "ON" : "OFF")
    end
    if s = server_side_encryption
      text = case s
             in :aes256 then "AES256"
             in :aws_kms then "aws:kms"
             else raise ArgumentError.new("server_side_encryption: :aes256 or :aws_kms, not #{s.inspect}")
             end
      headers = headers.put("x-amz-server-side-encryption", text)
    end
    if k = ssekms_key_id
      raise ArgumentError.new("ssekms_key_id goes with server_side_encryption: :aws_kms") unless server_side_encryption == :aws_kms
      headers = headers.put("x-amz-server-side-encryption-aws-kms-key-id", k)
    end
    if owner = expected_bucket_owner
      raise ArgumentError.new("expected_bucket_owner: an account id of 12 digits") unless owner.match?(/\A[0-9]{12}\z/)
      headers = headers.put("x-amz-expected-bucket-owner", owner)
    end
    metadata.each do |name, value|
      unless name.match?(/\A[!#$%&'*+.^_`|~0-9A-Za-z-]+\z/)
        raise ArgumentError.new("metadata: the name #{name.inspect} is not a header token")
      end
      unless value.bytes.all? { |b| b >= 0x20 && b < 0x7f }
        raise ArgumentError.new("metadata: the value of #{name.inspect} is not printable ASCII")
      end
      headers = headers.put("x-amz-meta-#{name}", value)
    end
    req = HTTP::Client::Request.put(url_for(bucket, key), body: data)
    headers.each { |n, v| req = req.header(n, v) }
    req
  end

  # Reads the object `key` of `bucket` (its `version_id` when given),
  # whole, within `max_bytes` (a bound, not a range: a larger object is
  # [ObjectTooLarge], never a cut body). Asks for the object's checksum
  # and checks a SHA-256 of the whole object against the body (see
  # [GetObjectOutput]).
  #
  # ## Raises
  #
  # [ArgumentError] before anything is sent (as for `put_object`; and a
  # `max_bytes` below 0); [ObjectTooLarge]; [ChecksumMismatch];
  # [ServiceError] for S3's errors, `NoSuchKey` (404) for a missing key,
  # or `AccessDenied` (403) for a missing key when the caller may not
  # list the bucket (S3 does not say which; the status is kept); [WrongRegion];
  # [TransportError] when no answer came.
  def get_object(*, bucket: String, key: String, max_bytes: Int, version_id: String? = nil,
                 expected_bucket_owner: String? = nil) -> GetObjectOutput
    raise ArgumentError.new("max_bytes: at least 0, not #{max_bytes}") if max_bytes < 0
    req = read_request("GET", bucket: bucket, key: key, version_id: version_id, expected_bucket_owner: expected_bucket_owner)
    big = ObjectTooLarge.new("S3 GetObject: the object is larger than max_bytes (#{max_bytes})")
    answer = @transport.send(req, "S3 GetObject", ANSWER_LIMIT, ->(status: Int, h: HTTP::Headers, text: String) { S3.error(status, h, text) },
                             success_limit: max_bytes, too_large: big)
    h = answer.headers
    checksum = S3.checksum_of(h)
    verified = false
    if (c = checksum) && c.algorithm == :sha256 && !S3.composite?(h, c)
      unless c.value == Base64.encode(Digest::SHA256.digest(answer.body))
        raise ChecksumMismatch.new("S3 GetObject: the body does not match the SHA-256 checksum S3 gave")
      end
      verified = true
    end
    GetObjectOutput.new(answer.body, h["content-type"], h["etag"] || "", h["x-amz-version-id"], S3.last_modified(h),
                        S3.metadata_of(h), S3.lock_mode(h), S3.retain_until(h), S3.legal_hold(h), checksum, verified)
  end

  # What `get_object` gives without the body: whether the object exists,
  # its size and its metadata.
  #
  # ## Raises
  #
  # As `get_object`. A HEAD answer has no body, so an error has a code
  # synthesized from its status: `NotFound` (404), `Forbidden` (403: also
  # a missing key when the caller may not list the bucket), `HTTP<status>`
  # else; [WrongRegion] from `x-amz-bucket-region`.
  def head_object(*, bucket: String, key: String, version_id: String? = nil,
                  expected_bucket_owner: String? = nil) -> HeadObjectOutput
    req = read_request("HEAD", bucket: bucket, key: key, version_id: version_id, expected_bucket_owner: expected_bucket_owner)
    answer = @transport.send(req, "S3 HeadObject", ANSWER_LIMIT, ->(status: Int, h: HTTP::Headers, text: String) { S3.error(status, h, "") })
    h = answer.headers
    length = h["content-length"] || ""
    unless length.match?(/\A[0-9]{1,18}\z/)
      raise ServiceError.new(code: "MalformedAnswer", message: "S3 HeadObject answered no Content-Length", status: answer.status)
    end
    HeadObjectOutput.new(length.to_i, h["content-type"], h["etag"] || "", h["x-amz-version-id"], S3.last_modified(h),
                         S3.metadata_of(h), S3.lock_mode(h), S3.retain_until(h), S3.legal_hold(h), S3.checksum_of(h))
  end

  # One page of the keys of `bucket` under `prefix` (all keys without
  # one): one request. `continuation_token` is the previous page's
  # `next_continuation_token`; `max_keys` (1 to 1000) bounds the page (S3
  # gives up to 1000 by default, and may give fewer). A caller loops while
  # `next_continuation_token` is not nil:
  #
  # ```quarz no_run
  # token: String? = nil
  # loop do
  #   page = s3.list_objects_v2(bucket: "exports-123456789012", prefix: "daily/", continuation_token: token)
  #   page.objects.each { |o| puts o.key }
  #   token = page.next_continuation_token
  #   break if token.nil?
  # end
  # ```
  #
  # The request asks for `encoding-type=url`, so that a key holding a
  # character XML 1.0 cannot carry still comes back, and each key is
  # decoded: it is exactly the key. (An answer that does not say it is so
  # encoded, from a store that ignores the parameter, is taken as it is.)
  # The answer is read within [LIST_LIMIT] bytes.
  #
  # ## Raises
  #
  # [ArgumentError] before anything is sent (a bucket name S3's rules
  # refuse, `max_keys` outside 1 to 1000, an owner that is not 12 digits,
  # an empty token); [ServiceError] for S3's errors (`NoSuchBucket`,
  # `AccessDenied`) and an answer this client cannot read
  # (`MalformedAnswer`); [WrongRegion]; [TransportError] when no answer
  # came or it was larger than [LIST_LIMIT].
  def list_objects_v2(*, bucket: String, prefix: String? = nil, continuation_token: String? = nil, max_keys: Int? = nil,
                      expected_bucket_owner: String? = nil) -> ListObjectsV2Output
    req = list_request(bucket: bucket, prefix: prefix, continuation_token: continuation_token, max_keys: max_keys,
                       expected_bucket_owner: expected_bucket_owner)
    answer = @transport.send(req, "S3 ListObjectsV2", ANSWER_LIMIT, ->(status: Int, h: HTTP::Headers, text: String) { S3.error(status, h, text) },
                             success_limit: LIST_LIMIT)
    S3.listing(answer.text("S3 ListObjectsV2"))
  end

  # :nodoc:
  # The unsigned GET `list_objects_v2` sends, its arguments checked.
  def list_request(*, bucket: String, prefix: String? = nil, continuation_token: String? = nil, max_keys: Int? = nil,
                   expected_bucket_owner: String? = nil) -> HTTP::Client::Request
    S3.check_bucket(bucket)
    query = ["list-type=2", "encoding-type=url"]
    if (p = prefix)
      query = query.push("prefix=#{SigV4.encode(p)}") unless p.empty?
    end
    if (t = continuation_token)
      raise ArgumentError.new("continuation_token: empty") if t.empty?
      query = query.push("continuation-token=#{SigV4.encode(t)}")
    end
    if (m = max_keys)
      raise ArgumentError.new("max_keys: 1 to 1000, not #{m}") unless m >= 1 && m <= 1000
      query = query.push("max-keys=#{m}")
    end
    req = HTTP::Client::Request.get(bucket_url(bucket).with(query: query.join("&")))
    if owner = expected_bucket_owner
      raise ArgumentError.new("expected_bucket_owner: an account id of 12 digits") unless owner.match?(/\A[0-9]{12}\z/)
      req = req.header("x-amz-expected-bucket-owner", owner)
    end
    req
  end

  # :nodoc:
  # A listing's document as its output. Raises [ServiceError]
  # "MalformedAnswer" for one this client cannot read.
  def self.listing(text: String) -> ListObjectsV2Output
    malformed = ->(what: String) { ServiceError.new(code: "MalformedAnswer", message: "S3 ListObjectsV2 answered #{what}", status: 200) }
    top: Hash[String, String] = {}
    entries: Array[Hash[String, String]] = []
    begin
      top = XML.fields(text, ["IsTruncated", "NextContinuationToken", "EncodingType"], ["ListBucketResult"])
      entries = XML.each_element(text, "Contents", ["Key", "Size", "ETag", "LastModified"], ["ListBucketResult"])
    rescue XML::Refused => e
      raise malformed.call("XML this client does not take: #{e.message}")
    end
    encoded = top["EncodingType"]? == "url"
    objects = entries.map do |f|
      raw = f["Key"]? || raise(malformed.call("an object without a key"))
      size = f["Size"]? || ""
      raise malformed.call("an object without a size") unless size.match?(/\A[0-9]{1,18}\z/)
      key = encoded ? (S3.url_decode(raw) || raise(malformed.call("a key that is not URL-encoded UTF-8"))) : raw
      modified = begin
                   (m = f["LastModified"]?) ? Time.iso8601(m) : nil
                 rescue ArgumentError
                   nil
                 end
      ObjectSummary.new(key, size.to_i, f["ETag"]? || "", modified)
    end
    token = top["NextContinuationToken"]?
    token = nil if token == ""
    if top["IsTruncated"]? == "true" && token.nil?
      raise malformed.call("a truncated page without a continuation token")
    end
    ListObjectsV2Output.new(objects, top["IsTruncated"]? == "true" ? token : nil)
  end

  # :nodoc:
  # `text` URL-decoded as S3's `encoding-type=url` writes it (`+` a space,
  # `%XX` a byte), or nil when an escape is malformed or the bytes are not
  # UTF-8.
  #
  # ```
  # AWS::S3.url_decode("a+b%2Bc/%C3%BC")   # => "a b+c/ü"
  # ```
  def self.url_decode(text: String) -> String?
    b = Bytes::Builder.new
    bytes = text.to_bytes
    i = 0
    while i < bytes.size
      c = bytes[i]
      if c == 37
        return nil unless i + 2 < bytes.size
        hex = bytes.slice(i + 1, 2).decode? || ""
        return nil unless hex.match?(/\A[0-9A-Fa-f]{2}\z/)
        b << hex.to_i(16)
        i += 3
      else
        b << (c == 43 ? 32 : c)
        i += 1
      end
    end
    b.to_bytes.decode?
  end

  # :nodoc:
  # The unsigned GET or HEAD of `key` (its version when given), asking
  # for the checksum, its arguments checked.
  def read_request(method: String, *, bucket: String, key: String, version_id: String? = nil,
                   expected_bucket_owner: String? = nil) -> HTTP::Client::Request
    S3.check_bucket(bucket)
    url = url_for(bucket, key)
    if (v = version_id)
      raise ArgumentError.new("version_id: empty") if v.empty?
      url = url.with(query: "versionId=#{SigV4.encode(v)}")
    end
    req = method == "HEAD" ? HTTP::Client::Request.head(url) : HTTP::Client::Request.get(url)
    req = req.header("x-amz-checksum-mode", "ENABLED")
    if owner = expected_bucket_owner
      raise ArgumentError.new("expected_bucket_owner: an account id of 12 digits") unless owner.match?(/\A[0-9]{12}\z/)
      req = req.header("x-amz-expected-bucket-owner", owner)
    end
    req
  end

  # :nodoc:
  # The URL of `key` in `bucket`: virtual-hosted, or path style for a
  # dotted bucket name or an overridden endpoint (see the class). Every
  # object operation's URL is made here. An empty key raises
  # [ArgumentError]: its URL would name the bucket itself, which S3 reads
  # as a bucket operation (a PUT as CreateBucket, a GET as ListObjects).
  # A key of `/` is an object's (`//`, `/{bucket}//` in path style).
  def url_for(bucket: String, key: String) -> URI
    raise ArgumentError.new("key: empty (the URL would name the bucket, not an object)") if key.empty?
    located(bucket, S3.key_path(key))
  end

  # :nodoc:
  # The URL of `bucket` itself, for a bucket operation (a listing):
  # `https://{bucket}.s3.{region}.amazonaws.com/`, or `/{bucket}` in path
  # style.
  def bucket_url(bucket: String) -> URI
    u = located(bucket, "")
    u.path.empty? ? u.with(path: "/") : u
  end

  # :nodoc:
  # `path` (empty, or from `/`) in `bucket`, addressed as the class says.
  def located(bucket: String, path: String) -> URI
    if o = @override
      base = o.path.end_with?("/") ? o.path[0, o.path.size - 1] : o.path
      return o.with(path: "#{base}/#{bucket}#{path}", query: nil)
    end
    region = @config.region
    unless region.match?(/\A[a-z0-9]+(-[a-z0-9]+)*\z/)
      raise ArgumentError, "not a region: #{region.inspect}"
    end
    if bucket.include?(".")
      URI.parse("https://s3.#{region}.amazonaws.com/#{bucket}#{path}")
    else
      URI.parse("https://#{bucket}.s3.#{region}.amazonaws.com#{path}")
    end
  end

  # :nodoc:
  # `key` as a path: `/` and each segment percent-encoded once (every
  # byte but the unreserved ones), as SigV4 signs it for `s3`. Empty,
  # `.` and `..` segments stay as they are.
  #
  # ```
  # AWS::S3.key_path("a b/ü/c+d")   # => "/a%20b/%C3%BC/c%2Bd"
  # ```
  def self.key_path(key: String) -> String = "/" + key.split("/", -1).map { |s| SigV4.encode(s) }.join("/")

  # :nodoc:
  # Raises [ArgumentError] unless `name` follows S3's naming rules: 3 to
  # 63 characters, lower-case letters, digits, hyphens and dots, starting
  # and ending with a letter or a digit, no `..`, not an IP address's
  # form. (So no `/`, `@`, `:`, `?`, `#` or upper case reaches a URL.)
  def self.check_bucket(name: String) -> Void
    ok = name.match?(/\A[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]\z/) && !name.include?("..") && !name.match?(/\A\d+\.\d+\.\d+\.\d+\z/)
    raise ArgumentError.new("not a bucket name S3 takes: #{name.inspect}") unless ok
  end

  # :nodoc:
  # `t` as Object Lock's date: ISO 8601, UTC, to the millisecond.
  def self.timestamp(t: Time) -> String
    u = t.utc
    "#{u.strftime("%Y-%m-%dT%H:%M:%S")}.#{(u.nsec / 1_000_000).to_s.rjust(3, "0")}Z"
  end

  # :nodoc:
  # Whether `c` is a checksum of a multipart upload's parts (S3's
  # `x-amz-checksum-type: COMPOSITE`, or a value ending `-N`), which no
  # body can be checked against.
  def self.composite?(h: HTTP::Headers, c: Checksum) -> Bool
    (h["x-amz-checksum-type"] || "").upcase == "COMPOSITE" || c.value.match?(/-[0-9]+\z/)
  end

  # :nodoc:
  # `x-amz-meta-*`, by the name after the prefix, lowercased.
  def self.metadata_of(h: HTTP::Headers) -> Hash[String, String]
    m = Hash[String, String].new
    h.each do |n, v|
      name = n.downcase
      m = m.put(name.delete_prefix("x-amz-meta-"), v) if name.start_with?("x-amz-meta-") && name.size > 11
    end
    m
  end

  # :nodoc:
  # `Last-Modified`, nil when absent or not an HTTP date.
  def self.last_modified(h: HTTP::Headers) -> Time? = Time.httpdate?(h["last-modified"] || "")

  # :nodoc:
  # The Object Lock mode an answer gives. Another value than S3's two is
  # a [ServiceError] "MalformedAnswer".
  def self.lock_mode(h: HTTP::Headers) -> Symbol?
    case h["x-amz-object-lock-mode"]
    in nil then nil
    in "GOVERNANCE" then :governance
    in "COMPLIANCE" then :compliance
    else raise ServiceError.new(code: "MalformedAnswer", message: "S3 answered an Object Lock mode that is not GOVERNANCE or COMPLIANCE", status: 200)
    end
  end

  # :nodoc:
  # The retention date an answer gives (ISO 8601); a malformed one is a
  # [ServiceError] "MalformedAnswer".
  def self.retain_until(h: HTTP::Headers) -> Time?
    text = h["x-amz-object-lock-retain-until-date"]
    return nil if text.nil?
    begin
      Time.iso8601(text)
    rescue ArgumentError
      raise ServiceError.new(code: "MalformedAnswer", message: "S3 answered a retention date that is not ISO 8601", status: 200)
    end
  end

  # :nodoc:
  # The legal hold an answer gives (`ON`, `OFF`), nil without one.
  def self.legal_hold(h: HTTP::Headers) -> Bool?
    case h["x-amz-object-lock-legal-hold"]
    in nil then nil
    in "ON" then true
    in "OFF" then false
    else raise ServiceError.new(code: "MalformedAnswer", message: "S3 answered a legal hold that is not ON or OFF", status: 200)
    end
  end

  # :nodoc:
  # The checksum an answer's headers give, the one sent first.
  def self.checksum_of(h: HTTP::Headers) -> Checksum?
    CHECKSUM_HEADERS.each do |alg, name|
      if v = h[name]
        return Checksum.new(alg, v)
      end
    end
    nil
  end

  # :nodoc:
  # The error of an answer: S3's XML document (`Code`, `Message`,
  # `RequestId`), or the status alone when there is none (a HEAD, a
  # 301, a proxy's page). Without S3's document the code is synthesized
  # here, not S3's (the SDKs' names): `PermanentRedirect` for a 301,
  # `SlowDown` for a 503 (tried again through its status either way),
  # `NotFound` for a 404, `Forbidden` for a 403, for a 400 with
  # `x-amz-bucket-region` `AuthorizationHeaderMalformed` (a HEAD to the
  # wrong region), `HTTP<status>` else. A wrong region raises
  # [WrongRegion] naming the bucket's.
  def self.error(status: Int, headers: HTTP::Headers, text: String) -> ServiceError
    f = begin
          XML.fields(text, ["Code", "Message", "RequestId", "Region"], ["Error"])
        rescue XML::Refused
          Hash[String, String].new
        end
    code = f["Code"]? || ""
    if code.empty?
      code = case status
             in 301 then "PermanentRedirect"
             in 503 then "SlowDown"
             in 404 then "NotFound"
             in 403 then "Forbidden"
             in 400 then headers["x-amz-bucket-region"] ? "AuthorizationHeaderMalformed" : "HTTP400"
             else "HTTP#{status}"
             end
    end
    message = f["Message"]? || ""
    request_id = f["RequestId"]? || headers["x-amz-request-id"]
    if code == "PermanentRedirect" || code == "AuthorizationHeaderMalformed"
      region = headers["x-amz-bucket-region"] || f["Region"]?
      if code == "PermanentRedirect" || region
        said = region ? "the bucket is in #{region}" : "the bucket is in another region"
        return WrongRegion.new(code: code, message: message.empty? ? said : "#{said}: #{message}", status: status,
                               request_id: request_id, region: region)
      end
    end
    ServiceError.new(code: code, message: message, status: status, request_id: request_id)
  end
end
